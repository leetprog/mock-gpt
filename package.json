{
  "name": "mock-gpt",
  "version": "0.1.0",
  "description": "A TypeScript mock of Google Publisher Tag (googletag) for use in tests.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/mock-gpt.js",
  "jsdelivr": "./dist/mock-gpt.js",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./create": {
      "types": "./dist/create.d.ts",
      "import": "./dist/create.js",
      "require": "./dist/create.cjs"
    }
  },
  "scripts": {
    "dev": "vitest",
    "build": "vite build && vite build -c vite.iife.config.ts && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/google-publisher-tag": "^1.20261109.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
